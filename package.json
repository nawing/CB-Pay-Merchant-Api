{
  "name": "@mmpay/cb-mmqr",
  "version": "1.0.4",
  "description": "MMQR, CB Pay - Integration Package By MyanMyanPay",
  "keywords": [
    "MMQR",
    "CB Pay"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nawing/CB-Pay-Merchant-Api.git"
  },
  "bugs": {
    "url": "https://github.com/nawing/CB-Pay-Merchant-Api/issues"
  },
  "homepage": "https://github.com/nawing/CB-Pay-Merchant-Api#readme",
  "engines": {
    "node": "^26.6.5",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "bun run clean && bun run check && bun run build:esm && bun run build:cjs",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "dotenv": "^17.2.2",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Naw Ing",
  "license": "ISC"
}
