{
  "name": "@mmpay/cb-mmqr",
  "version": "1.0.3",
  "description": "MMQR, CB Pay - Integration Package By MyanMyanPay",
  "keywords": [
    "MMQR",
    "CB Pay"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nawing/CB-Pay-Merchant-Api.git"
  },
  "bugs": {
    "url": "https://github.com/nawing/CB-Pay-Merchant-Api/issues"
  },
  "homepage": "https://github.com/nawing/CB-Pay-Merchant-Api#readme",
  "engines": {
    "node": "^26.6.5",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "test": "node --test test/test.js",
    "test:bun": "bun test test/test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "dotenv": "^17.2.2",
    "typescript": "^5.4.0",
    "@types/node": "^26.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Naw Ing",
  "license": "ISC"
}
